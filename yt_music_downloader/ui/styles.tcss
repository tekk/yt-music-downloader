/* Main Application Layout */
Screen {
    layout: vertical;
    background: $background;
    color: $text;
}

#header-container {
    height: 3;
    dock: top;
    background: $surface;
    border-bottom: solid $primary;
    padding: 0 1;
    layout: horizontal;
    align: center middle;
}

#app-title {
    text-style: bold;
    color: $primary;
    width: 1fr;
}

#auth-badge {
    height: 1;
    padding: 0 1;
    background: $surface-lighten-1;
    color: $text;
    border: none;
    text-style: bold;
}

.auth-logged-in {
    color: $success;
    text-style: bold;
}

.auth-guest {
    color: $warning;
}

/* URL Input & Options Bar */
#input-panel {
    height: auto;
    background: $surface;
    padding: 1;
    margin: 1 1 0 1;
    border: solid $surface-lighten-1;
}

#input-row {
    layout: horizontal;
    height: 3;
    align: left middle;
}

#url-input {
    width: 1fr;
    margin-right: 1;
}

#inspect-btn {
    width: 14;
    margin-right: 1;
}

#options-row {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align: left middle;
}

.option-item {
    margin-right: 2;
    layout: horizontal;
    align: left middle;
}

.option-label {
    padding-right: 1;
    color: $text-muted;
    text-style: bold;
}

#format-select {
    width: 28;
}

#quality-select {
    width: 18;
}

/* Content Area & Tabs */
#content-tabs {
    height: 1fr;
    margin: 1 1 0 1;
}

TabPane {
    padding: 0;
}

#tracks-table {
    height: 1fr;
    border: solid $surface-lighten-1;
}

#log-view {
    height: 1fr;
    border: solid $surface-lighten-1;
    background: $surface-darken-1;
    color: $text;
}

/* Progress Panel */
#progress-panel {
    height: auto;
    background: $surface;
    padding: 1;
    margin: 1 1 0 1;
    border: solid $primary;
}

.progress-row {
    layout: horizontal;
    height: 1;
    margin-bottom: 1;
    align: left middle;
}

.progress-label {
    width: 16;
    text-style: bold;
    color: $text;
}

.progress-stat {
    width: 1fr;
    text-align: right;
    color: $text-muted;
}

#current-progress-bar {
    width: 1fr;
    margin-right: 1;
}

#overall-progress-bar {
    width: 1fr;
    margin-right: 1;
}

#status-ticker {
    height: 1;
    color: $accent;
    text-style: bold;
    padding: 0 1;
}

/* Action Controls Bar */
#actions-bar {
    height: 3;
    margin: 1;
    layout: horizontal;
    align: center middle;
}

.action-btn {
    margin-right: 1;
}

#download-btn {
    background: $success;
    color: $text;
    text-style: bold;
}

#cancel-btn {
    background: $error;
    color: $text;
}

/* Modal Dialogs */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.65);
}

.modal-dialog {
    width: 72;
    height: auto;
    max-height: 85%;
    background: $surface;
    border: thick $primary;
    padding: 1 2;
}

.modal-title {
    text-align: center;
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    border-bottom: solid $surface-lighten-1;
    padding-bottom: 1;
}

.modal-section-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
    margin-bottom: 0;
}

.modal-desc {
    color: $text-muted;
    margin-bottom: 1;
}

.modal-buttons {
    layout: horizontal;
    align: right middle;
    margin-top: 2;
}

.modal-buttons Button {
    margin-left: 1;
}

#browser-select {
    width: 100%;
    margin-bottom: 1;
}

#cookie-log {
    height: 6;
    background: $surface-darken-1;
    border: solid $surface-lighten-1;
    margin-top: 1;
    margin-bottom: 1;
}

#settings-container {
    height: auto;
}

.setting-row {
    layout: horizontal;
    height: 3;
    align: left middle;
    margin-bottom: 1;
}

.setting-label {
    width: 22;
    color: $text;
}

.setting-input {
    width: 1fr;
}
